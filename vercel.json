{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        { "src": "/.well-known/(.*)", "dest": "/.well-known/$1" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}
